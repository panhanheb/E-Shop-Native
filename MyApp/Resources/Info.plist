<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the Info.plist Xcode generates from the INFOPLIST_KEY_* build settings. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<!-- Supported languages; makes iOS show Settings > MyApp > Language (English / Khmer). -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>km</string>
	</array>
</dict>
</plist>
