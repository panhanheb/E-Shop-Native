    "Something Went Wrong" : { "localizations" : { "km" : { "stringUnit" : { "state" : "translated", "value" : "មានបញ្ហាកើតឡើង" } } } },
    "Start organizing your work in minutes." : { "localizations" : { "km" : { "stringUnit" : { "state" : "translated", "value" : "ចាប់ផ្តើមរៀបចំការងាររបស់អ្នកក្នុងរយៈពេលប៉ុន្មាននាទី។" } } } },
