    "Tasks" : { "localizations" : { "km" : { "stringUnit" : { "state" : "translated", "value" : "កិច្ចការ" } } } },
    "The request could not be prepared." : { "localizations" : { "km" : { "stringUnit" : { "state" : "translated", "value" : "មិនអាចរៀបចំសំណើបានទេ។" } } } },
    "The request URL is invalid." : { "localizations" : { "km" : { "stringUnit" : { "state" : "translated", "value" : "URL នៃសំណើមិនត្រឹមត្រូវ។" } } } },
    "The requested item could not be found." : { "localizations" : { "km" : { "stringUnit" : { "state" : "translated", "value" : "រកមិនឃើញធាតុដែលបានស្នើសុំទេ។" } } } },
    "The server response could not be read." : { "localizations" : { "km" : { "stringUnit" : { "state" : "translated", "value" : "មិនអាចអានការឆ្លើយតបពីម៉ាស៊ីនមេបានទេ។" } } } },
    "The server returned an error (%lld). Please try again later." : { "localizations" : { "km" : { "stringUnit" : { "state" : "translated", "value" : "ម៉ាស៊ីនមេមានកំហុស (%lld)។ សូមព្យាយាមម្តងទៀតនៅពេលក្រោយ។" } } } },
    "The server returned an invalid response." : { "localizations" : { "km" : { "stringUnit" : { "state" : "translated", "value" : "ម៉ាស៊ីនមេបានឆ្លើយតបមិនត្រឹមត្រូវ។" } } } },
    "Theme" : { "localizations" : { "km" : { "stringUnit" : { "state" : "translated", "value" : "ស្បែក" } } } },
    "This action cannot be undone." : { "localizations" : { "km" : { "stringUnit" : { "state" : "translated", "value" : "សកម្មភាពនេះមិនអាចត្រឡប់វិញបានទេ។" } } } },
    "Title" : { "localizations" : { "km" : { "stringUnit" : { "state" : "translated", "value" : "ចំណងជើង" } } } },
    "Try a different search or filter." : { "localizations" : { "km" : { "stringUnit" : { "state" : "translated", "value" : "សូមសាកល្បងពាក្យស្វែងរក ឬតម្រងផ្សេងទៀត។" } } } },
    "Try Again" : { "localizations" : { "km" : { "stringUnit" : { "state" : "translated", "value" : "ព្យាយាមម្តងទៀត" } } } },
    "Version" : { "localizations" : { "km" : { "stringUnit" : { "state" : "translated", "value" : "កំណែ" } } } },
    "Welcome Back" : { "localizations" : { "km" : { "stringUnit" : { "state" : "translated", "value" : "សូមស្វាគមន៍ការត្រឡប់មកវិញ" } } } },
    "You appear to be offline. Check your connection and try again." : { "localizations" : { "km" : { "stringUnit" : { "state" : "translated", "value" : "ហាក់ដូចជាអ្នកមិនបានភ្ជាប់អ៊ីនធឺណិត។ សូមពិនិត្យការតភ្ជាប់ ហើយព្យាយាមម្តងទៀត។" } } } },
    "Your profile could not be found." : { "localizations" : { "km" : { "stringUnit" : { "state" : "translated", "value" : "រកមិនឃើញប្រវត្តិរូបរបស់អ្នកទេ។" } } } },
    "Your session has expired. Please sign in again." : { "localizations" : { "km" : { "stringUnit" : { "state" : "translated", "value" : "វគ្គប្រើប្រាស់របស់អ្នកបានផុតកំណត់។ សូមចូលគណនីម្តងទៀត។" } } } }
