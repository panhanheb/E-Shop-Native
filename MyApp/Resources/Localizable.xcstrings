    "View All": {
      "localizations": {
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មើលទាំងអស់"
          }
        }
      }
    },
    "We'll let you know about new arrivals, special offers, and order updates.": {
      "localizations": {
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "យើងនឹងជូនដំណឹងអ្នកអំពីទំនិញថ្មី ការផ្តល់ជូនពិសេស និងបច្ចុប្បន្នភាពការបញ្ជាទិញ។"
          }
        }
      }
    },
    "Welcome Back": {
      "localizations": {
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សូមស្វាគមន៍ការត្រឡប់មកវិញ"
          }
        }
      }
    },
    "Wishlist": {
      "localizations": {
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បញ្ជីប្រាថ្នា"
          }
        }
      }
    },
    "You appear to be offline. Check your connection and try again.": {
      "localizations": {
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ហាក់ដូចជាអ្នកមិនបានភ្ជាប់អ៊ីនធឺណិត។ សូមពិនិត្យការតភ្ជាប់ ហើយព្យាយាមម្តងទៀត។"
          }
        }
      }
    },
    "You can track this order in the Orders tab.": {
      "localizations": {
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកអាចតាមដានការបញ្ជាទិញនេះនៅក្នុងផ្ទាំង «ការបញ្ជាទិញ»។"
          }
        }
      }
    },
    "Your Cart Is Empty": {
      "localizations": {
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កន្ត្រករបស់អ្នកទទេ"
          }
        }
      }
    },
    "Your order %@ has been placed.": {
      "localizations": {
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការបញ្ជាទិញ %@ របស់អ្នកត្រូវបានដាក់ដោយជោគជ័យ។"
          }
        }
      }
    },
    "Your profile could not be found.": {
      "localizations": {
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រកមិនឃើញប្រវត្តិរូបរបស់អ្នកទេ។"
          }
        }
      }
    },
    "Your session has expired. Please sign in again.": {
      "localizations": {
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វគ្គប្រើប្រាស់របស់អ្នកបានផុតកំណត់។ សូមចូលគណនីម្តងទៀត។"
          }
        }
      }
    },
    "Your Wishlist Is Empty": {
      "localizations": {
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បញ្ជីប្រាថ្នារបស់អ្នកទទេ"
