            "value": "ផ្តល់រង្វាន់ដល់ខ្លួនឯងថ្ងៃនេះ"
          }
        }
      }
    },
    "Try a different search or category.": {
      "localizations": {
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សូមសាកល្បងពាក្យស្វែងរក ឬប្រភេទផ្សេងទៀត។"
          }
        }
      }
    },
    "Try Again": {
      "localizations": {
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ព្យាយាមម្តងទៀត"
          }
        }
      }
    },
    "Up to %lld%% Off": {
      "localizations": {
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បញ្ចុះតម្លៃរហូតដល់ %lld%%"
          }
        }
